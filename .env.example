# Application Config
ENVIRONMENT=development
PORT=8000

# CORS (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Configuration
MODEL_VERSION=v1.0.0

# Dynamic Model Loading
USE_MOCK_MODEL=True
MODEL_ARTIFACT_PATH=
MODEL_ARTIFACT_TYPE=joblib  # joblib or pickle

# Dynamic Schema Validation
# Set to path of a json file (e.g., input_schema.json) to strictly validate input dictionary
INPUT_SCHEMA_PATH=
